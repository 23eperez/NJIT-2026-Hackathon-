#include <SPI.h>
#include <MFRC522.h>

// Pin configuration for MFRC522
#define SS_PIN 10   // SDA pin on MFRC522
#define RST_PIN 9   // RST pin on MFRC522

// Create MFRC522 instance
MFRC522 mfrc522(SS_PIN, RST_PIN);

/// Retry configuration
const int MAX_RETRIES = 3;
const int RETRY_DELAY = 5000; // 5 seconds

void setup() {
  Serial.begin(9600);
  delay(1000); // Give serial time to initialize
  
  Serial.println("\n=== MFRC522 NFC Reader Initialization ===\n");
  
 / / Initialize SPI bus
  Serial.println("Step 1: Initializing SPI bus...");
  SPI.begin();
  Serial.println("✓ SPI bus initialized successfully!\n");
  
  /// Initialize MFRC522 with error handling
  Serial.println("Step 2: Initializing MFRC522 reader...");
  initializeMFRC522();
  
  /// Verify antenna gain
  Serial.println("\nStep 3: Verifying antenna...");
  byte rxGain = mfrc522.PCD_GetAntennaGain();
  Serial.print("✓ Antenna Gain: ");
  Serial.print(rxGain);
  Serial.println(" dB\n");
  
  Serial.println("=== Initialization Complete ===");
  Serial.println("Place your NFC tag near the reader...\n");
}

void loop() {
  /// Look for new cards
  if (!mfrc522.PICC_IsNewCardPresent()) {
    return;
  }
  
  // Select one of the cards
  if (!mfrc522.PICC_ReadCardSerial()) {
    return;
  }
  
  /// Print UID
  Serial.print("UID tag: ");
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i] < 0x10 ? " 0" : " ");
    Serial.print(mfrc522.uid.uidByte[i], HEX);
  }
  Serial.println();
  
  /// Print card type
  byte piccType = mfrc522.PICC_GetType(mfrc522.uid.sak);
  Serial.print("Card Type: ");
  Serial.println(mfrc522.PICC_GetTypeName(piccType));
  
  /// Halt PICC
  mfrc522.PICC_HaltA();
  Serial.println("---");
}

/**
 * Initialize MFRC522 with retry logic
 * Attempts initialization up to MAX_RETRIES times
 * If all attempts fail, halts execution
 */
void initializeMFRC522() {
  int retryCount = 0;
  MFRC522::StatusCode status;
  
  while (retryCount < MAX_RETRIES) {
    Serial.print("  Retry attempt ");
    Serial.print(retryCount + 1);
    Serial.print(" of ");
    Serial.println(MAX_RETRIES);
    
    /// Attempt initialization
    status = mfrc522.PCD_Init(SS_PIN, RST_PIN);
    
    /// Check if initialization was successful
    if (status == MFRC522::STATUS_OK) {
      Serial.println("✓ MFRC522 initialized successfully!\n");
      return; // Exit function on success
    }
    
    /// Print error message
    Serial.print("  ✗ Initialization failed: ");
    Serial.println(mfrc522.GetStatusCodeName(status));
    
    retryCount++;
    
    /// If not the last retry, wait before next attempt
    if (retryCount < MAX_RETRIES) {
      Serial.print("  Retrying in ");
      Serial.print(RETRY_DELAY / 1000);
      Serial.println(" seconds...\n");
      delay(RETRY_DELAY);
    }
  }
  
  /// If we reach here, all retries have failed
  Serial.println("\n✗✗✗ FATAL ERROR ✗✗✗");
  Serial.print("Failed to initialize MFRC522 after ");
  Serial.print(MAX_RETRIES);
  Serial.println(" attempts.");
  Serial.println("Please check:");
  Serial.println("  - Wiring connections (SS, RST, SPI pins)");
  Serial.println("  - MFRC522 library installation");
  Serial.println("  - Power supply to the reader");
  Serial.println("  - SPI bus configuration");
  Serial.println("\nSystem halted.\n");
  
  /// Halt execution
  while (1) {
    delay(1000); // Prevent watchdog timeout
  }
}
